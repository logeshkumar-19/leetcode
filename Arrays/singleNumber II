class Solution {
    public int singleNumber(int[] nums) {
        Map<Integer,Integer> lk=new HashMap<>();
        for(int num:nums){
            lk.put(num,lk.getOrDefault(num,0)+1);

        }
        for(int key:lk.keySet()){
            if(lk.get(key)==1) return key;
        }
        return -1;
        
    }
}
