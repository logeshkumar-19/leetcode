class Solution {
    public int maxProfit(int[] p) {
        int min=Integer.MAX_VALUE;
        int max=0;
        for( int price:p){
            if(price<min){
                 min =price;
                 }

            else{
               max= Math.max(max,price-min);

            }
        }

       
        return max;

                
        
    }
}
