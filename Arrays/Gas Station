class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {

        int st=0;
        int cur=0;
        int tot=0;
        for(int i=0;i<gas.length;i++){
            int diff=gas[i]-cost[i];
            cur=cur + diff;
            tot=tot + diff;
            if(cur<0){
                st=i+1;
                cur=0;
            }
        }
        return tot >= 0 ? st : -1;
        
    }
}
