class Solution {
    public int compress(char[] ch) {
        StringBuilder sb=new StringBuilder();
        int count =1;
        for(int i=1;i<=ch.length;i++){
            if(i<ch.length&&ch[i]==ch[i-1]){
                count++;
            }
            else{
                 sb.append(ch[i-1]);
                 if(count>1){
                   sb.append(count);
                 }
                count =1;
            }
         }
        for(int i=0;i<sb.length();i++){
                ch[i] = sb.charAt(i);
            }
            return sb.length();
    }
}
